// The window's controls, after Raycast's Theme Studio: yellow toggles, short sliders with their
// value, text segments, value-and-chevron menus, square colour swatches, keycaps, tags, and the
// pieces the three panes are built from (list rows, tiles, inspector rows).

import { Theme, Tags } from "theme.slint";

/// A Segoe Fluent Icons glyph (Segoe MDL2 Assets on Windows 10), centred in its box.
export component Icon inherits Text {
    in property <string> glyph;
    in property <length> size: 14px;
    // Windows 10's MDL2 (icons::in_mdl2): its Folder stands upright, FolderHorizontal is Fluent's;
    // its charging battery is wider.
    text: Theme.mdl2 && glyph == "\u{E8B7}" ? "\u{F12B}" : glyph;
    font-family: Theme.icons;
    font-size: glyph == "\u{EBB3}" ? size * Theme.battery-scale : size;
    color: Theme.glyph;
    horizontal-alignment: center;
    vertical-alignment: center;
}

/// Keyboard focus, drawn only when the keyboard put it there.
component Ring inherits Rectangle {
    in property <length> radius;
    in property <length> w;
    in property <length> h;
    x: -3px;
    y: -3px;
    width: w + 6px;
    height: h + 6px;
    border-radius: radius + 3px;
    border-width: 2px;
    border-color: Theme.acc;
}

/// Raycast's toggle in the accent: a dark knob on yellow when on.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: checked ? Theme.acc : Theme.off-track;
    opacity: enabled ? 1 : 0.4;
    animate background { duration: Theme.motion-standard; easing: cubic-bezier(0.2, 0, 0, 1); }
    Rectangle {
        x: root.checked ? root.width - 17px : 3px;
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.checked ? Theme.knob-on : Theme.off-knob;
        animate x { duration: Theme.motion-standard; easing: cubic-bezier(0.2, 0, 0, 1); }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return accept;
            }
            reject
        }
    }
    if focus.has-focus: Ring { radius: Theme.control-radius; w: root.width; h: root.height; }
}

/// A short slider with its value beside it ("%92", "Ortada"). Drag, click, arrow keys.
export component MiniSlider inherits HorizontalLayout {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    /// What the value reads as.
    in property <string> text;
    /// A centre mark, and values near zero snap to it (Konum).
    in property <bool> centred;
    in property <bool> enabled: true;
    callback moved(float);
    spacing: 10px;
    alignment: end;
    opacity: enabled ? 1 : 0.4;

    property <float> p: (value - minimum) / max(1, maximum - minimum);

    function snap(v: float) -> float {
        let s = clamp(round(v / step) * step, minimum, maximum);
        return centred && abs(s) <= 4 ? 0 : s;
    }
    function set(v: float) {
        let s = snap(v);
        if s != root.value {
            root.value = s;
            root.moved(s);
        }
    }

    track := Rectangle {
        width: 84px;
        height: 20px;
        property <length> thumb-x: 7px + root.p * (self.width - 14px);
        property <length> mid-x: 7px + (0 - root.minimum) / max(1, root.maximum - root.minimum) * (self.width - 14px);
        Rectangle {
            y: 8px;
            height: 4px;
            border-radius: 2px;
            background: Theme.track;
        }
        Rectangle {
            y: 8px;
            height: 4px;
            border-radius: 2px;
            background: Theme.acc;
            x: root.centred ? min(track.mid-x, track.thumb-x) : 0px;
            width: root.centred ? abs(track.thumb-x - track.mid-x) : track.thumb-x;
        }
        if root.centred: Rectangle {
            x: track.mid-x - 1px;
            y: 5px;
            width: 2px;
            height: 10px;
            background: Theme.text3;
        }
        Rectangle {
            x: track.thumb-x - 7px;
            y: 3px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: Theme.text;
            if focus.has-focus: Ring { radius: 7px; w: 14px; h: 14px; }
        }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    root.set(root.minimum + (self.mouse-x - 7px) / max(1px, track.width - 14px) * (root.maximum - root.minimum));
                }
            }
            moved => {
                if self.pressed {
                    root.set(root.minimum + (self.mouse-x - 7px) / max(1px, track.width - 14px) * (root.maximum - root.minimum));
                }
            }
            scroll-event(e) => {
                if e.delta-y > 0 { root.set(root.value + root.step); return accept; }
                if e.delta-y < 0 { root.set(root.value - root.step); return accept; }
                reject
            }
        }
        focus := FocusScope {
            enabled: root.enabled;
            focus-on-click: false;
            key-pressed(e) => {
                if e.text == Key.LeftArrow || e.text == Key.DownArrow { root.set(root.value - root.step); return accept; }
                if e.text == Key.RightArrow || e.text == Key.UpArrow { root.set(root.value + root.step); return accept; }
                if e.text == Key.Home { root.set(root.minimum); return accept; }
                if e.text == Key.End { root.set(root.maximum); return accept; }
                reject
            }
        }
    }
    Text {
        min-width: 44px;
        text: root.text;
        font-size: 14px;
        font-weight: 500;
        color: Theme.strong;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

/// Text segments without a box (Raycast's "Solid | Gradient"): the chosen one on a raised step.
export component Seg inherits HorizontalLayout {
    in property <[string]> options;
    in-out property <int> selected;
    callback picked(int);
    spacing: 2px;
    for o[i] in root.options: Rectangle {
        height: 28px;
        width: label.preferred-width + 20px;
        border-radius: 8px;
        background: root.selected == i ? Theme.seg-on : t.has-hover ? Theme.hov : transparent;
        animate background { duration: Theme.motion-fast; }
        label := Text {
            text: o;
            font-size: 13.5px;
            font-weight: 500;
            color: root.selected == i ? Theme.strong : Theme.text2;
            vertical-alignment: center;
        }
        t := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if root.selected != i {
                    root.selected = i;
                    root.picked(i);
                }
            }
        }
    }
}

/// One keycap ("Ctrl", "K", "↵").
export component Keycap inherits Rectangle {
    in property <string> key;
    in property <length> size: 22px;
    height: size;
    width: max(size, label.preferred-width + 12px);
    border-radius: 6px;
    background: Theme.key;
    label := Text {
        text: root.key;
        font-size: root.size > 22px ? 12.5px : 11.5px;
        font-weight: 500;
        color: Theme.key-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// A coloured label on its own tint ("Gösteriliyor", "Gizli", "Canlı").
export component Tag inherits Rectangle {
    in property <string> text;
    in property <color> tint: Tags.grey;
    in property <bool> small;
    height: small ? 22px : 26px;
    width: label.preferred-width + (small ? 16px : 22px);
    border-radius: 7px;
    background: tint.with-alpha(Theme.dark ? 0.2 : 0.18);
    label := Text {
        text: root.text;
        font-size: root.small ? 12px : 13.5px;
        font-weight: 500;
        color: Theme.dark ? root.tint.brighter(8%) : root.tint.darker(45%);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Raycast's round check (list rows).
export component Check inherits Rectangle {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 1.6px;
    border-color: Theme.text;
    Icon {
        glyph: "\u{E73E}";
        size: 9px;
        color: Theme.text;
    }
}

/// A small icon button (the inspector's header).
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: t.has-hover && enabled ? Theme.hov : transparent;
    opacity: enabled ? 1 : 0.35;
    Icon {
        glyph: root.glyph;
        size: 14px;
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A value with a chevron that opens a menu of choices (Raycast's theme picker).
export component Select inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    /// Shows and marks this option instead of `selected` (a list whose index isn't kept).
    in property <string> current-text;
    in property <length> box-width: 120px;
    in property <bool> keys;
    callback picked(int);
    width: box-width;
    height: 30px;
    border-radius: 8px;
    background: Theme.field;
    border-width: 1px;
    border-color: open ? Theme.acc : t.has-hover ? Theme.text3 : Theme.field-edge;
    property <bool> open;
    property <int> hot: selected;
    property <string> shown: current-text != "" ? current-text : selected >= 0 && selected < options.length ? options[selected] : "";

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 6px;
        Text {
            text: root.shown;
            font-size: 13.5px;
            color: Theme.strong;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Icon {
            glyph: "\u{E70D}";
            size: 9px;
            width: 10px;
            color: Theme.text2;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.show-menu(); }
    }
    function show-menu() {
        root.hot = root.selected;
        root.open = true;
        menu.show();
    }
    function choose(i: int) {
        menu.close();
        root.open = false;
        if i != root.selected || root.current-text != "" {
            root.selected = i;
            root.picked(i);
        }
    }
    pure function is-current(i: int, o: string) -> bool {
        return root.current-text != "" ? o == root.current-text : root.selected == i;
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return || e.text == Key.DownArrow {
                root.show-menu();
                return accept;
            }
            reject
        }
    }
    if focus.has-focus: Ring { radius: 8px; w: root.width; h: root.height; }

    menu := PopupWindow {
        x: root.width - max(root.width, 200px);
        y: root.height + 6px;
        width: max(root.width, 200px);
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: 12px;
            background: Theme.pop;
            border-width: 1px;
            border-color: Theme.pop-edge;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: Theme.pop-shadow;
            FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    if e.text == Key.Escape { menu.close(); root.open = false; return accept; }
                    if e.text == Key.DownArrow { root.hot = min(root.hot + 1, root.options.length - 1); return accept; }
                    if e.text == Key.UpArrow { root.hot = max(root.hot - 1, 0); return accept; }
                    if e.text == Key.Return || e.text == " " { root.choose(root.hot); return accept; }
                    reject
                }
                VerticalLayout {
                    padding: 6px;
                    for o[i] in root.options: Rectangle {
                        height: 32px;
                        border-radius: 8px;
                        background: root.hot == i ? Theme.sel-row : row.has-hover ? Theme.hov : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: Theme.space-small;
                            Text {
                                text: o;
                                font-size: 14px;
                                font-weight: 500;
                                color: Theme.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Icon {
                                glyph: root.is-current(i, o) ? "\u{E73E}" : "";
                                size: 11px;
                                width: 14px;
                                color: Theme.acc;
                            }
                        }
                        row := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.choose(i); }
                        }
                    }
                }
            }
        }
    }
}

/// A square colour swatch (Raycast's Start Color) that opens a palette and a hex field.
export component Swatch inherits Rectangle {
    in-out property <string> hex;
    in property <color> value;
    in property <[color]> presets;
    in property <[string]> preset-hex;
    callback picked(string);
    /// `#RRGGBB` the caller accepts.
    pure callback valid(string) -> bool;
    width: 24px;
    height: 24px;
    border-radius: 7px;
    border-width: 1.6px;
    border-color: Theme.ring;
    background: value;
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { pop.show(); }
    }
    pop := PopupWindow {
        x: root.width - 236px;
        y: root.height + 8px;
        width: 236px;
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: 12px;
            background: Theme.pop;
            border-width: 1px;
            border-color: Theme.pop-edge;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: Theme.pop-shadow;
            VerticalLayout {
                padding: 12px;
                spacing: Theme.space-medium;
                HorizontalLayout {
                    spacing: Theme.space-small;
                    for c[i] in root.presets: Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        background: c;
                        border-width: root.hex == root.preset-hex[i] ? 2px : 0px;
                        border-color: Theme.strong;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.hex = root.preset-hex[i];
                                root.picked(root.hex);
                            }
                        }
                    }
                }
                Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: Theme.field;
                    border-width: 1px;
                    border-color: field.has-focus ? Theme.acc : Theme.field-edge;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: Theme.space-small;
                        Rectangle {
                            width: 14px;
                            height: 14px;
                            y: 9px;
                            border-radius: 4px;
                            background: root.value;
                        }
                        field := TextInput {
                            text: root.hex;
                            font-size: 14px;
                            color: Theme.strong;
                            vertical-alignment: center;
                            single-line: true;
                            edited => {
                                if root.valid(self.text) {
                                    root.hex = self.text.to-uppercase();
                                    root.picked(root.hex);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ inspector (right pane)

/// A labelled group in the inspector, with a hairline above it.
export component ISection inherits Rectangle {
    in property <string> title;
    in property <bool> first;
    Rectangle {
        visible: !root.first;
        y: 0px;
        height: 1px;
        background: Theme.line;
    }
    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 6px;
        padding-bottom: 8px;
        Text {
            height: 36px;
            text: root.title;
            font-size: Theme.text-body;
            color: Theme.label;
            vertical-alignment: center;
        }
        @children
    }
}

/// One inspector row: a white label on the left, its control on the right.
export component IRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> note;
    height: note != "" ? 54px : 40px;
    spacing: Theme.space-medium;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text {
            text: root.label;
            font-size: 14.5px;
            font-weight: 500;
            color: Theme.strong;
            overflow: elide;
        }
        if root.note != "": Text {
            text: root.note;
            font-size: 12.5px;
            color: Theme.text2;
            overflow: elide;
        }
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: end;
            // A HorizontalLayout stretches its children's height by default, and pins one
            // that can't stretch (a Tag's fixed height) to its top: centre them instead.
            cross-axis-alignment: center;
            @children
        }
    }
}

// ------------------------------------------------------------------ preview (middle pane)

/// A section header in the preview: "Pil  3 etkinlik".
export component H4 inherits HorizontalLayout {
    in property <string> title;
    in property <string> count;
    padding-left: 10px;
    padding-top: 16px;
    padding-bottom: 8px;
    spacing: Theme.space-small;
    alignment: start;
    Text {
        text: root.title;
        font-size: Theme.text-body;
        font-weight: 500;
        color: Theme.section;
    }
    Text {
        text: root.count;
        font-size: Theme.text-body;
        color: Theme.text3;
    }
}

/// A list row: leading mark, title, grey subtitle, and accessories on the right (children).
export component LRow inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <bool> selected;
    in property <bool> clickable;
    /// Leading: 0 the round check, 1 a glyph, 2 an image, 3 a badge letter, 4 nothing.
    in property <int> lead;
    in property <string> glyph;
    in property <image> image;
    in property <string> letter;
    in property <color> badge;
    in property <color> badge-text: white;
    callback clicked;
    height: 44px;
    border-radius: 10px;
    background: selected ? Theme.sel-row : t.has-hover && clickable ? Theme.hov : transparent;
    t := TouchArea {
        enabled: root.clickable;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: Theme.space-medium;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            if root.lead == 0: Check { }
            if root.lead == 1: Icon {
                width: 22px;
                height: 22px;
                glyph: root.glyph;
                size: 15px;
                color: Theme.text2;
            }
            if root.lead == 2: Image {
                width: 22px;
                height: 22px;
                source: root.image;
                image-fit: contain;
            }
            if root.lead == 3: Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 6px;
                background: root.badge;
                Text {
                    text: root.letter;
                    font-size: 11px;
                    font-weight: 700;
                    color: root.badge-text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.title;
            font-size: 14px;
            font-weight: 500;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0;
        }
        Text {
            text: root.sub;
            font-size: 14px;
            color: Theme.text2;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: Theme.space-small;
                alignment: end;
                // Accessories of different heights (a Tag beside a pill or an icon button)
                // share one centre line, not the top edge.
                cross-axis-alignment: center;
                @children
            }
        }
    }
}

/// A grid tile: a picture (children) above its name and a grey line; the chosen one framed
/// in the accent.
export component Tile inherits VerticalLayout {
    in property <string> title;
    in property <string> sub;
    in property <bool> selected;
    in property <bool> clickable: true;
    in property <brush> fill: Theme.tile;
    in property <length> picture-height: 140px;
    callback clicked;
    spacing: 0px;
    pic := Rectangle {
        height: root.picture-height;
        border-radius: 12px;
        background: root.fill;
        border-width: 2px;
        border-color: root.selected ? Theme.tile-on : t.has-hover && root.clickable ? Theme.text3.with-alpha(0.5) : transparent;
        animate border-color { duration: Theme.motion-fast; }
        @children
        t := TouchArea {
            enabled: root.clickable;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
    Rectangle { height: 9px; }
    Text {
        text: root.title;
        font-size: 14px;
        font-weight: 500;
        color: Theme.text;
        overflow: elide;
    }
    Text {
        text: root.sub;
        font-size: Theme.text-body;
        color: Theme.text2;
        overflow: elide;
    }
}

// ------------------------------------------------------------------ list panel (left pane)

/// An entry in the list panel: a round icon (dark, or white for the window's own pages),
/// the name, and a check when the activity is in the pill now.
export component SideItem inherits Rectangle {
    in property <string> title;
    in property <string> glyph;
    in property <bool> light;
    in property <bool> ball;
    in property <bool> current;
    in property <bool> live;
    in property <bool> off;
    callback clicked;
    height: 38px;
    border-radius: 9px;
    background: current ? Theme.sel : t.has-hover ? Theme.hov : transparent;
    animate background { duration: Theme.motion-fast; }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 8px;
        spacing: 11px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: root.light ? #F7F7F7 : #050505;
                border-width: root.light ? 0px : 1px;
                border-color: #FFFFFF1F;
                if !root.ball: Icon {
                    glyph: root.glyph;
                    size: 12px;
                    color: root.light ? #111111 : #FFFFFF;
                }
                // The football (not in Segoe Fluent Icons): a ring and its centre panel.
                if root.ball: Path {
                    width: 12px;
                    height: 12px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    stroke: #FFFFFF;
                    stroke-width: 1.4px;
                    commands: "M 8 1.5 A 6.5 6.5 0 1 1 7.99 1.5 Z M 8 4.6 L 10.6 6.5 L 9.6 9.6 L 6.4 9.6 L 5.4 6.5 Z";
                }
            }
        }
        Text {
            text: root.title;
            font-size: 14.5px;
            font-weight: 500;
            color: Theme.strong;
            opacity: root.off ? 0.55 : 1;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.off: Text {
            text: @tr("Kapalı");
            font-size: 12px;
            color: Theme.text3;
            vertical-alignment: center;
        }
        if root.live && !root.off: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: #FFFFFF1A;
                Icon {
                    glyph: "\u{E73E}";
                    size: 10px;
                    color: #CFCFCF;
                }
            }
        }
    }
}
